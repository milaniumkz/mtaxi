# MTaxi backend env example.
# Copy to .env on the rented server or set these values in the process manager.

# HTTP
NODE_ENV=production
PORT=8080
MTAXI_PUBLIC_BASE_URL=https://api.example.kz
# Local/compose only. Production must keep this false.
MTAXI_ALLOW_LOCAL_PUBLIC_BASE_URL=false
# Local/compose only. Production public backend URL must be HTTPS.
MTAXI_ALLOW_INSECURE_PUBLIC_BASE_URL=false
MTAXI_CORS_ORIGINS=https://mtaxi-user-vzqw6a.web.app,https://mtaxi-controls.web.app
MTAXI_JSON_BODY_LIMIT=25mb
# Behind nginx/Caddy/Traefik set true or hop count, e.g. 1.
MTAXI_TRUST_PROXY=false
# Request logs write method/path/status/duration/requestId only. No request body is logged.
MTAXI_ACCESS_LOGS=true
# Local compatibility only. Production preflight requires false.
MTAXI_ENABLE_LEGACY_CREATE_TOKEN=false

# Background maintenance. 0 = disabled for local debugging, production: 30.
MTAXI_MAINTENANCE_INTERVAL_SEC=30
MTAXI_PENDING_ORDER_TTL_MIN=15
MTAXI_MAINTENANCE_ORDER_LIMIT=100
MTAXI_MAINTENANCE_PUSH_LIMIT=100

# Auth/session
# Set a long random value in production. Changing it signs out existing users.
MTAXI_TOKEN_SECRET=replace-with-long-random-secret
MTAXI_SMS_CODE_TTL_SEC=300
MTAXI_SMS_RESEND_COOLDOWN_SEC=30
MTAXI_AUTH_RATE_LIMIT_WINDOW_SEC=60
MTAXI_AUTH_RATE_LIMIT_MAX=20
# Local/dev only. Production should send SMS through backend provider and keep this false.
MTAXI_SMS_DEV_RETURN_CODE=false
# Authentication uses phone + password; SMS endpoints are disabled. No SMS provider required.
MTAXI_SMS_PROVIDER=disabled
# Local/compose only. Do not enable on production.
MTAXI_ALLOW_LOCAL_SMS=false
MTAXI_SMS_MESSAGE_TEMPLATE=MTaxi code: {{code}}
MTAXI_SMS_HTTP_URL=
MTAXI_SMS_HTTP_METHOD=POST
MTAXI_SMS_HTTP_BEARER_TOKEN=
MTAXI_SMS_HTTP_HEADERS=
MTAXI_SMS_HTTP_BODY_TEMPLATE={"phone":"{{phone}}","message":"{{message}}","code":"{{code}}"}

# First admin bootstrap, used by npm run seed:admin or Docker auto seed.
MTAXI_SEED_ADMIN_ON_START=false
# Replace with a real admin phone before enabling MTAXI_SEED_ADMIN_ON_START.
MTAXI_ADMIN_PHONE=+77000000000
MTAXI_ADMIN_PASSWORD=replace-with-admin-password
MTAXI_ADMIN_NAME=Администратор
MTAXI_ADMIN_CITY=Белоусовка

# Store
# Local development: json. Production: postgres.
MTAXI_STORE=postgres
# Docker Compose passes this value directly to the postgres container.
POSTGRES_PASSWORD=replace-with-postgres-password
DATABASE_URL=postgres://mtaxi:replace-with-postgres-password@postgres:5432/mtaxi

# Local JSON migration source, used by npm run db:migrate-json.
MTAXI_DATA_DIR=/var/lib/mtaxi/data
MTAXI_JSON_FILE=/var/lib/mtaxi/data/local-db.json

# Uploads
MTAXI_UPLOAD_DIR=/var/lib/mtaxi/uploads
MTAXI_MAX_UPLOAD_BYTES=10485760
MTAXI_UPLOAD_CACHE_MAX_AGE_SEC=2592000

# Backup
MTAXI_BACKUP_RETENTION_DAYS=30

# Geocoding / places
MTAXI_GEOCODING_USER_AGENT=MTaxiBackend/1.0
MTAXI_GOOGLE_PLACES_API_KEY=

# Payments
# Production: redirect (supported by production preflight and deployment tooling).
# Kassa24 integration requires production validation before enabling. Local: dev only.
MTAXI_PAYMENT_PROVIDER=redirect
# Manual Kaspi invoices with admin confirmation: MTAXI_PAYMENT_PROVIDER=kaspi_manual.
# The driver UI requests kaspi_manual explicitly; this mode needs no payment API keys.
# Local/compose only. Do not enable on production.
MTAXI_ALLOW_LOCAL_PAYMENT=false
MTAXI_KASSA24_LOGIN=replace-with-kassa24-login
MTAXI_KASSA24_PASSWORD=replace-with-kassa24-password
MTAXI_KASSA24_MERCHANT_ID=replace-with-kassa24-merchant-id
MTAXI_KASSA24_CREATE_URL=https://ecommerce.pult24.kz/payment/create
# Use only when MTAXI_PAYMENT_PROVIDER=redirect.
MTAXI_PAYMENT_URL_TEMPLATE=https://pay-provider.example/start?invoice={{paymentId}}&amount={{amount}}
MTAXI_PAYMENT_CALLBACK_SECRET=replace-with-payment-callback-secret
# Production should pass callback secret through headers, not JSON body.
MTAXI_ALLOW_PAYMENT_CALLBACK_SECRET_IN_BODY=false

# FCM push transport. Firebase is used only for push notifications.
MTAXI_FCM_ENABLED=true
# Local/compose only. Preflight rejects this when NODE_ENV=production.
MTAXI_ALLOW_SIMULATED_PUSH=false
# Use one of these on production when enabling MTAXI_FCM_ENABLED=true:
FIREBASE_SERVICE_ACCOUNT_JSON=
# Firebase project used exclusively for FCM push.
FIREBASE_PROJECT_ID=mtaxi-52990
# GOOGLE_APPLICATION_CREDENTIALS=/etc/mtaxi/firebase-service-account.json
