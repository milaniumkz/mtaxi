        <key>CFBundleURLSchemes</key>
        <array>
        <string>mtaxi</string>
        </array>
        </dict>
    </array>
    <key>FlutterDeepLinkingEnabled</key>
    <true/>


	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>

	<key>NSLocationWhenInUseUsageDescription</key>
    <string>MTaxi uses your location to determine the pickup point, show the nearest address, calculate the trip price, and help the driver find you faster, for example when you order a taxi from your current location.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>MTaxi uses your location while the app is active and during order processing so the pickup point, route, nearby address, and driver tracking work correctly for passenger and driver trips.</string>
	<key>NSCameraUsageDescription</key>
    <string>MTaxi uses the camera so you can take and attach a photo of an address, luggage, a found item, a receipt, or another situation that needs to be shown to the driver or operator.</string>
	<key>NSPhotoLibraryUsageDescription</key>
    <string>MTaxi uses the photo library so you can choose and attach a photo of an address, luggage, a found item, a receipt, or another situation that needs to be sent to the driver or operator.</string>
	<key>PermissionGroupNotification</key>
    <string>Получение уведомлений</string>
	<key>NSCalendarsUsageDescription</key>
    <string>Выбор даты рождения</string>
