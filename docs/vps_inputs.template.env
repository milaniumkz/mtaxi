# MTaxi VPS inputs template.
# Copy this file, fill real values, then run:
# ./scripts/check_vps_inputs.sh path/to/vps_inputs.env

MTAXI_VPS_HOST=
MTAXI_VPS_USER=
MTAXI_API_DOMAIN=api.mtaxi.kz
MTAXI_PUBLIC_BASE_URL=https://api.mtaxi.kz
MTAXI_CORS_ORIGINS=https://mtaxi-user-vzqw6a.web.app,https://mtaxi-controls.web.app
MTAXI_DNS_READY=false
MTAXI_HTTPS_READY=false


# Authentication: phone + password, no SMS fees.
MTAXI_SMS_PROVIDER=disabled

MTAXI_PAYMENT_URL_TEMPLATE='https://pay-provider.example/start?invoice={{paymentId}}&amount={{amount}}'
MTAXI_PAYMENT_CALLBACK_SECRET=

# Use one of these for FCM push only.
FIREBASE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=

MTAXI_ADMIN_PHONE=
MTAXI_ADMIN_PASSWORD=
MTAXI_ADMIN_NAME=
MTAXI_ADMIN_CITY=
